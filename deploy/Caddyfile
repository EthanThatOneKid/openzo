# Caddy terminates TLS (automatic Let's Encrypt) and proxies to the host.
# flush_interval -1 keeps the agent's NDJSON stream unbuffered; websockets
# (the terminal, site websockets) pass through reverse_proxy natively.
#
# Sites: custom domains users attach and <site>-<user>.$OPENZO_SITES_DOMAIN
# get certificates on demand — Caddy asks openzo first, and openzo only says
# yes for hostnames it actually serves.
{
	on_demand_tls {
		ask http://127.0.0.1:{$OPENZO_PORT:8080}/api/sites/tls-ask
	}
}

{$OPENZO_DOMAIN} {
	encode zstd gzip {
		match {
			not path /eve/*
		}
	}
	reverse_proxy 127.0.0.1:{$OPENZO_PORT:8080} {
		flush_interval -1
		transport http {
			read_timeout 0
		}
	}
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:{$OPENZO_PORT:8080} {
		flush_interval -1
	}
}
