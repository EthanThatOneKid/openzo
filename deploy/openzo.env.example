# /etc/openzo/openzo.env — read by openzo.service, openzo-firewall.service and
# Caddy. Every variable is documented in docs/GUIDE.md.

OPENZO_DOMAIN=zo.example.com
OPENZO_PUBLIC_URL=https://zo.example.com
OPENZO_HOST=127.0.0.1
OPENZO_PORT=8080
OPENZO_TRUST_PROXY=1
OPENZO_DATA=/var/lib/openzo

# gvisor = one runsc container per user (multi-user). process = no isolation.
OPENZO_DRIVER=gvisor
OPENZO_AGENT_IMAGE=openzo-agent:latest
OPENZO_OCI_RUNTIME=runsc
OPENZO_DOCKER_NETWORK=openzo
OPENZO_SUBNET=172.30.0.0/24
OPENZO_USER_MEMORY=2g
OPENZO_USER_CPUS=1
OPENZO_USER_PIDS=512
OPENZO_IDLE_MINUTES=30
OPENZO_MAX_RUNTIMES=50

# open | invite | closed
OPENZO_SIGNUP=invite
# Lane for users who haven't picked one: free | mock | openai | ...
OPENZO_DEFAULT_LANE=free

# Bundled SearXNG (loopback) and the internal listener that proxies it to
# user containers on the bridge gateway.
OPENZO_SEARXNG_URL=http://127.0.0.1:8888
OPENZO_INTERNAL_HOST=172.30.0.1
OPENZO_INTERNAL_PORT=8091

# Comma-separated extra host ports user containers may reach on the gateway,
# e.g. 11434 for an Ollama server on the host. Empty = none.
OPENZO_ALLOW_HOST_PORTS=

# Sites: give every site its own subdomain <site>-<user>.<domain>. Needs a
# wildcard DNS record (*.sites.example.com → this server); Caddy issues
# certificates on demand. Empty = sites only under /s/<user>/<site>/.
OPENZO_SITES_DOMAIN=
OPENZO_MAX_SERVICES=10

# Outgoing mail for the email channel (smtps://…:465 or smtp://…:587).
OPENZO_SMTP_URL=
OPENZO_SMTP_FROM=
